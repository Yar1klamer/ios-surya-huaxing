diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2310,6 +2310,17 @@
 	va_l1 = dynamic_memory_begin;
 	va_l1_end = va_l1 + ((2 + (mem_segments * 10)) << 20);
 	va_l1_end += round_page(args->Video.v_height * args->Video.v_rowBytes);
+#if defined(ARM64_BOARD_CONFIG_SURYA)
+	/*
+	 * The 512 MiB RAM-disk target gives the RAM-scaled formula only about
+	 * 32 MiB of early I/O VA. Serial fbcon and initialize_screen each map
+	 * the 1080x2400 framebuffer before KMEM; the latter was observed to
+	 * cross the last prepared L3 table (0xfffffe000c000000).
+	 * Reserve page-table coverage, not physical device memory, for both
+	 * console aliases and the remaining early platform mappings.
+	 */
+	va_l1_end = MAX(va_l1_end, va_l1 + (64ULL << 20));
+#endif
 	va_l1_end = (va_l1_end + 0x00000000007FFFFFULL) & 0xFFFFFFFFFF800000ULL;
 
 	cpu_l1_tte = cpu_tte + ((va_l1 & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
