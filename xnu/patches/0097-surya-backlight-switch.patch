+ * SURYA's backlight switch below (one bit of one register, read back).
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
+#include <kern/locks.h>
