@@ -29,6 +31,9 @@ static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
 static uint32_t keys_version, keys_last_status;
 static bool keys_started;
 static int keys_sleep_chan;
+/* One transfer at a time through the arbiter: with two at once it drops one. */
+static LCK_GRP_DECLARE(keys_spmi_grp, "sweet-keys-spmi");
