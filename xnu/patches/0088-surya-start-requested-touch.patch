+	int touch_enabled = 0;
+	(void)PE_parse_boot_argn("sweettouch", &touch_enabled, sizeof(touch_enabled));
+	if (su.writable && touch_enabled == 1) {
+		printf("SURYA TOUCH: starting requested driver after root storage setup\n");
+		sweet_touch_init();
+	}
 	return 0;
 #endif
 	sweet_log_start();
