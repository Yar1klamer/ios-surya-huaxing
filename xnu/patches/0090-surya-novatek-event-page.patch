+/* Xiaomi surya-q-oss nt36xxx_mem_map.h maps masked ID
+ * 0c xx xx 72 66 03 to NT36675_memory_map, EVENT_BUF_ADDR=0x22d00.
+ * nvt_set_page encodes address >> 15 and address >> 7. */
+static int
+surya_nvt_event_page(void)
+{
+	const uint8_t page[3] = {0xff, 0x04, 0x5a};
+	return surya_touch_spi_write(page, sizeof(page));
+}
+
+static int
+surya_nvt_firmware_state(void)
+{
+	uint8_t reset = 0, info[2] = {0, 0};
+	int err = 0;
+	unsigned attempt;
+	for (attempt = 0; attempt < 50; ++attempt) {
+		err = surya_nvt_event_page();
+		if (!err) err = surya_touch_spi_read(0x60, &reset, 1);
+		if (err) break;
+		if (reset >= 0xa0 && reset <= 0xaf) break;
+		surya_touch_wait(10);
+	}
+	if (!err) err = surya_touch_spi_read(0x78, info, sizeof(info));
+	printf("SURYA TOUCH: event=0x22d00 err=%d reset=%02x fw=%02x/%02x\n",
+	    err, reset, info[0], info[1]);
+	if (err) return err;
+	if (reset < 0xa0 || reset > 0xaf || (unsigned)info[0] + info[1] != 255u) {
+		printf("SURYA TOUCH: running firmware not established; firmware loader may be required\n");
+		return EAGAIN;
+	}
+	return 0;
+}
