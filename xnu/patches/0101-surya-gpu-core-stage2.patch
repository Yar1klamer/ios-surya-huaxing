 void surya_unixnu_smmu_capture(struct surya_unixnu_smmu_report *);
+
+/* G3b: when set, capture() stops (stage 3, code 0) right after reading context bank 0 and leaves its tables, activation
+ * and stream attachment to bsd/dev/surya_gpu_core.c. The I/O callbacks are the same ones capture() uses. */
+extern int surya_unixnu_stop_before_context;
+void surya_unixnu_smmu_io(vm_offset_t smmu, ArmSmmu4KIo *io);
 #endif
