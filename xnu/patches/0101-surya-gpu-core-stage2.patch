diff --git a/bsd/dev/surya_unixnu_smmu.c b/bsd/dev/surya_unixnu_smmu.c
--- a/bsd/dev/surya_unixnu_smmu.c
+++ b/bsd/dev/surya_unixnu_smmu.c
@@ -67,6 +67,21 @@ static int io_barrier(void *cookie)
     return 0;
 }
 
+int surya_unixnu_stop_before_context;
+
+void surya_unixnu_smmu_io(vm_offset_t smmu, ArmSmmu4KIo *io)
+{
+    *io = (ArmSmmu4KIo){
+        .cookie = (void *)smmu,
+        .register_bytes = SURYA_DT_SMMU_SIZE,
+        .read32 = io_read32,
+        .read64 = io_read64,
+        .write32 = io_write32,
+        .write64 = io_write64,
+        .barrier = io_barrier,
+    };
+}
+
 static int live_tables(struct surya_unixnu_smmu_report *r, vm_offset_t smmu)
 {
     vm_offset_t tables = 0, data = 0;
@@ -274,6 +289,12 @@ surya_unixnu_smmu_capture(struct surya_unixnu_smmu_report *r)
     printf("SURYA UNIXNU STEP 10: SCTLR=%#x FSR=%#x; read TTBR0\n", r->cb_sctlr, r->cb_fsr);
     delay(20000);
     r->cb_ttbr0 = read64(smmu, r->cb_offset + 0x20);
+    if (surya_unixnu_stop_before_context) {
+        printf("SURYA UNIXNU STEP 11: CB0 read; context and streams are left to the 3D core stage\n");
+        delay(20000);
+        r->stage = 3;
+        return;
+    }
     printf("SURYA UNIXNU STEP 11: CB0 read; build & activate live tables\n");
     delay(20000);
     r->stage = 4;
diff --git a/bsd/dev/surya_unixnu_smmu.h b/bsd/dev/surya_unixnu_smmu.h
