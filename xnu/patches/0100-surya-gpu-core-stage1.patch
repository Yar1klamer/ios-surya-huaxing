+    (void)PE_parse_boot_argn("suryacore", &core_stage, sizeof(core_stage));
+    if (core_stage > 0 && st.gx_powered) {
+        vm_offset_t core_regs = ml_io_map(SURYA_GPU_PA, SURYA_GPU_SIZE);
+        if (core_regs) surya_gpu_core_run(core_regs, (unsigned)core_stage, &core);
+    }
+
     for (;;) {
         disableConsoleOutput = sweet_console_muted = 0;
         printf("\nSURYA GPU PAGE TABLE DIAGNOSTIC: %s code=%d\n",
@@ -474,6 +484,14 @@ surya_gpu_pt_diagnostic(void)
                 zap.authenticated ? "TRUSTZONE AUTHENTICATED THE ZAP SHADER" : "NOT AUTHENTICATED",
                 zap.released ? "yes" : "no");
         }
+        if (core_stage > 0) {
+            printf("SURYA CORE: %s stage=%u/%u wrote=%u same=%u differ=%u RBBM_STATUS %#x->%#x\n",
+                core.asked ? "RAN" : "NOT RUN", core.done, core.stage, core.wrote, core.same, core.differ,
+                core.status_before, core.status_after);
+            for (unsigned i = 0; i < core.differ && i < SURYA_CORE_DIFFS; i++)
+                printf("SURYA CORE: DIFF %s @%#x wrote %#llx read %#llx\n", core.diffs[i].name, core.diffs[i].offset,
+                    core.diffs[i].wrote, core.diffs[i].read);
+        }
         printf("No GPU commands submitted; Metal acceleration not enabled\n");
         printf("Launchd intentionally paused. Power + Volume Down: Fastboot\n");
         (void)tsleep(&wait_channel, PZERO, "gpudiag", hz * 5);
