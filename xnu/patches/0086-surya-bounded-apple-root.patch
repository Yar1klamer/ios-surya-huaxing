diff --git a/bsd/dev/surya_ufs_policy.h b/bsd/dev/surya_ufs_policy.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/surya_ufs_policy.h
@@ -0,0 +1,21 @@
+/* SURYA native storage command and root-volume policy, shared with host tests. */
+#ifndef SURYA_UFS_POLICY_H
+#define SURYA_UFS_POLICY_H
+static inline int
+surya_ufs_command_allowed(unsigned opcode, int data_out, int writable)
+{
+	if (data_out) return writable && opcode == 0x2a; /* WRITE(10) */
+	return opcode == 0x00 || opcode == 0x28 || /* TEST UNIT READY, READ(10) */
+	    (writable && opcode == 0x35); /* SYNCHRONIZE CACHE(10) */
+}
+static inline int
+surya_ufs_root_range(unsigned long long first, unsigned long long count,
+    unsigned long long expected_first, unsigned long long expected_count,
+    unsigned long long image_blocks)
+{
+	/* WRITE(10) has a 32-bit LBA; every advertised block must fit. */
+	return first == expected_first && count == expected_count && first != 0 &&
+	    count != 0 && image_blocks >= 2 && image_blocks <= count &&
+	    first <= 0xffffffffULL && image_blocks - 1 <= 0xffffffffULL - first;
+}
+#endif
