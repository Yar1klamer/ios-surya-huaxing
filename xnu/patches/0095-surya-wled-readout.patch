+#if defined(ARM64_BOARD_CONFIG_SURYA)
+/*
+ * Read-only look at the backlight. The panel (NT36672C Huaxing, an IPS LCD) is lit by the WLED
+ * of the PM6150L (SID 5: control 0xd800, sink 0xd900, "qcom,pm6150l-spmi-wled"), so black pixels
+ * do not switch it off. Nothing is written; this is for comparing with Linux's leds-qcom-wled.c
+ * before any write is made.
+ */
+static void
+keys_dump_wled(uint32_t count)
+{
+	static const uint16_t ppid[] = { 0x5d8, 0x5d9 };
+	for (unsigned p = 0; p < 2; ++p) {
+		uint16_t apid = keys_find_apid(ppid[p], count);
+		if (apid == KEYS_NO_APID) {
+			printf("SURYA WLED: no channel for peripheral %#x\n", ppid[p]);
+			continue;
+		}
+		printf("SURYA WLED: peripheral %#x is apid %u (map %#x, owner %u)\n", ppid[p], apid,
+		    keys_rd(keys_core, 0x900u + 4u * apid), keys_rd(keys_cnfg, 0x700u + 4u * apid) & 7u);
+		for (unsigned base = 0; base < 0x100; base += 16) {
+			char line[16 * 3 + 1];
+			unsigned n = 0;
+			for (unsigned i = 0; i < 16; ++i) {
+				uint8_t v = 0;
+				if (keys_read(apid, (uint16_t)(base + i), &v)) {
+					n += snprintf(line + n, sizeof(line) - n, "%02x ", v);
+				} else {
+					n += snprintf(line + n, sizeof(line) - n, "-- ");
+				}
+			}
+			printf("SURYA WLED: %#x%02x: %s\n", ppid[p] & 0xff, base, line);
+		}
+	}
+}
+#endif
+
